<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>cw2mode_oracle</AssemblyName>
    <RootNamespace>cw2mode_oracle</RootNamespace>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../../temp/cwmode/oracle-bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../temp/cwmode/oracle-obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)../../../temp/cwmode/oracle-obj/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../reference/cw2mode/Program.cs" />
    <Compile Include="../oracle/StaticDebug.cs" />
    <Compile Include="Shim.cs" />
  </ItemGroup>
</Project>
