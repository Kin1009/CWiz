{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CWiz",
  "scopeName": "source.cwiz",
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "directives": {
      "patterns": [
        {
          "match": "^\\s*(#)(for|include|define|ifdef|ifndef|if|elif|else|endif|pragma|cwapp|slot|rop|org|launcher|pad|nopad|__asm__|__hex__)\\b(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.directive.cwiz" },
            "2": { "name": "keyword.control.directive.cwiz" },
            "3": { "name": "string.unquoted.directive.cwiz" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.cwiz", "match": "//.*$" },
        {
          "name": "comment.block.cwiz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cwiz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.cwiz", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.cwiz",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.cwiz", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.cwiz", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.cwiz", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cwiz",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|goto|sizeof|__asm__|__hex__)\\b"
        },
        {
          "name": "storage.modifier.cwiz",
          "match": "\\b(const|static|volatile|inline|extern|register|signed|unsigned|short|long|struct|enum|typedef)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cwiz",
          "match": "\\b(void|int|char|bool|byte|short|long|unsigned|signed|rom8|rom16|int8|int16|arr)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.cwiz",
          "match": "\\b(clear|pixel|line_draw|draw_line|line_print|printline|smallprint|print_small|render|render_dd|screen_del|buffer_clear|setlr|setsfr|setlr_pc|pop_xr0|pop_er0|hline|vline|rect|draw_rect|fillrect|line|circle|disc|text|char|glyph_cw|char_cw|text_cw|num_cw|print|print_cw|num|key|key_hit|key_down|wait_key|waitshift|delay|abs|min|max|rand|peek|poke|set_byte|set_word|add_word|memcpy|mem_copy|strcpy|str_copy|rpeek|rpoke|getkey|getscancode|getscancode_nodelay|getkeycode|keytable|table|_rpeek)\\b"
        },
        {
          "name": "constant.language.key.cwiz",
          "match": "\\bK_[A-Z0-9_]+\\b"
        },
        {
          "name": "constant.language.cwiz",
          "match": "\\b(NULL|true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.cwiz",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.cwiz",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
