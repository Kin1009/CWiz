{
  "CWiz program": {
    "prefix": "cwiz",
    "body": [
      "// ${1:program} - CWiz",
      "",
      "int main() {",
      "    clear();",
      "    text(4, 4, \"${2:Hello from CWiz}\");",
      "    while (1) {",
      "        delay(2);",
      "    }",
      "    return 0;",
      "}"
    ],
    "description": "A minimal CWiz program"
  },
  "CWiz app section": {
    "prefix": "cwapp",
    "body": [
      "#for 580",
      "#cwapp",
      "int main() {",
      "    clear();",
      "    text(4, 4, \"${1:Hello from CWiz}\");",
      "    wait_key();",
      "    return 0;",
      "}"
    ],
    "description": "#cwapp section (requires #for 580)"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${2:/* body */}",
      "}"
    ],
    "description": "if block"
  },
  "if / else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    ${2:/* then */}",
      "} else {",
      "    ${3:/* else */}",
      "}"
    ],
    "description": "if/else block"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "    ${3:/* body */}",
      "}"
    ],
    "description": "for loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${2:/* body */}",
      "}"
    ],
    "description": "while loop"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "${1:int} ${2:name}(${3:void}) {",
      "    ${4:return 0;}",
      "}"
    ],
    "description": "function definition"
  },
  "#for 580": {
    "prefix": "for580",
    "body": [
      "#for 580"
    ],
    "description": "restrict a section to the fx-580VN X"
  },
  "text": {
    "prefix": "text",
    "body": [
      "text(${1:x}, ${2:y}, \"${3:hello}\");"
    ],
    "description": "draw text on the LCD"
  },
  "key loop": {
    "prefix": "keyloop",
    "body": [
      "while (1) {",
      "    if (key_hit(K_AC)) break;",
      "    delay(2);",
      "}"
    ],
    "description": "poll the keyboard until AC"
  },
  "CWiz app with slot": {
    "prefix": "cwappslot",
    "body": [
      "#for 580",
      "#cwapp",
      "#slot ${1:2}",
      "int main() {",
      "    clear();",
      "    text(4, 4, \"${2:Hello from CWiz}\");",
      "    wait_key();",
      "    return 0;",
      "}"
    ],
    "description": "#cwapp section with a menu slot (1..12, default 2)"
  }
}
