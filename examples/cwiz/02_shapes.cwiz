// 02_shapes.cwiz - the drawing library: pixels, lines, rectangles and circles.
//
//   wizrun examples/cwiz/02_shapes.cwiz

void main() {
    clear();

    // a rectangle outline and a filled one
    rect(4, 4, 60, 30);
    fillrect(70, 4, 40, 14);

    // a circle, a disc and a diagonal line
    circle(140, 26, 18);
    disc(170, 26, 10);
    line(4, 56, 188, 40);

    // a 1-bit sprite held in a rom8 table (16x8, two bytes per row)
    sprite(4, 36, 16, 8, sprite_data);

    text(70, 24, "shapes");
}

rom8 char sprite_data[16] = "\x3C\x3C\x66\x66\xC3\xC3\xC3\xC3\xFF\xFF\xC3\xC3\xC3\xC3\xC3\xC3";
