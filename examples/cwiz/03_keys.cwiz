// 03_keys.cwiz - reading the keyboard: key(), key_down() and K_* constants.
//
//   wizrun examples/cwiz/03_keys.cwiz

int x = 90;
int y = 30;

void main() {
    clear();
    rect(0, 0, 192, 63);
    text(4, 4, "arrows move the box");

    while (1) {
        // held keys: move every frame
        if (key_down(K_LEFT) && x > 4) { x = x - 2; }
        if (key_down(K_RIGHT) && x < 176) { x = x + 2; }
        if (key_down(K_UP) && y > 14) { y = y - 2; }
        if (key_down(K_DOWN) && y < 54) { y = y + 2; }

        // a fresh press: leave the program
        if (key_hit(K_EXE)) { break; }

        clear();
        rect(0, 0, 192, 63);
        text(4, 4, "arrows move the box");
        fillrect(x, y, 12, 8);
    }

    clear();
    text(40, 28, "bye!");
}
