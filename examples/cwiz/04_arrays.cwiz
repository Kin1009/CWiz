// 04_arrays.cwiz - RAM arrays, ROM tables and strings.

const int N = 32;

int values[N];              // 32 words of RAM
rom int squares[11] = {0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100};
rom8 char title[20] = "CWiz arrays";

int total;

void main() {
    int i;

    // fill a RAM array with the squares from the ROM table
    for (i = 0; i <= 10; i = i + 1) {
        values[i] = squares[i];
    }

    // sum them
    total = 0;
    for (i = 0; i <= 10; i = i + 1) {
        total = total + values[i];
    }

    clear();
    text(0, 0, title);
    text(0, 12, "sum of squares 0..10:");
    num(0, 24, total);
    text(0, 36, "values[7] =");
    num(80, 36, values[7]);
}
