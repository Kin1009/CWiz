// 10_app_hello.cwiz - a cwapp program in CWiz: the CWiz twin of
// examples/10_app_hello.wz.
//
//   wizc  examples/cwiz/10_app_hello.cwiz                 (builds for 580)
//   wizc  examples/cwiz/10_app_hello.cwiz --cwapp         (builds the firmware app)
//   wizrun examples/cwiz/10_app_hello.cwiz --cwapp
//
// cwapp is a program that lives in segment 3 of an fx-580VN X firmware ROM and
// is entered from a menu icon (see patch_menu). `exit()` returns to the menu.
//
// `#for <model>` is the target directive (which calculator), and `#cwapp` marks
// the section that follows as the *app* - a patch for the fx-580VN X firmware
// rather than a ROM file. A `----` line ends the section, so what follows is
// built for every target:
//
//     #for 580        the 580 calculator (a normal ROM file)
//     #cwapp          the app: a 580VN X firmware patch (needs `--cwapp`)
//     ----            back to code that every target gets
//
// So leave() exists twice - as a no-op on 580, as exit() on cwapp - while
// draw() and main() are shared. Run as a plain 580 ROM the loop never leaves;
// as an app, AC returns to the calculator's menu.

#for 580
void leave() { }
#cwapp
void leave() { exit(); }
----

void draw() {
    clear();
    rect(0, 0, 192, 64);
    text(24, 20, "Hello from CWiz");
    text(24, 32, "press AC to exit");
}

void main() {
    draw();
    while (1) {
        if (key_down(K_AC)) { leave(); }
        delay(3);
    }
}
