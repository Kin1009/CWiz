// Extra app A: slot 13 is the D shortcut key.
#for 580
#cwapp 13 "keytest"
void draw(int k) {
    print_cw(78, 54, k);
    render();
}

void main() {
    buffered(1);
    clear();
    text(4, 4, "keytest");
    text(4, 16, "last key:");
    render();
    int last = -1;
    while (1) {
        int k = key();
        if (last != k)
        {
            print(60, 16, k);
            render();
        }
        last = k;
    }
}





