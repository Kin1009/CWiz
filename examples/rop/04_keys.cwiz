// rop/04_keys.cwiz — arrow-key menu with keytable.
#rop
#for 580
#org E9E0
#launcher common

int main() {
    setlr();
    setsfr();
    screen_del();
loop:
    getkey();
    keytable(0x0480, up, 0x0840, down, 0x0440, left, 0x0880, right, 0x0000, loop);
up: print(0x30, 0x01, "UP"); render(); goto loop;
down: print(0x30, 0x11, "DOWN"); render(); goto loop;
left: print(0x30, 0x21, "LEFT"); render(); goto loop;
right: print(0x30, 0x31, "RIGHT"); render(); goto loop;
}
